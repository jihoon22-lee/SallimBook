<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application>
        <!-- adb shell holds DUMP. Ordinary installed apps cannot open this proof.
             This declaration and its Activity exist only in the debug source set. -->
        <activity
            android:name="io.github.jihoon22lee.sallimbook.debugproof.SecurityProofActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:allowTaskReparenting="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:label="SallimBook 합성 보안 검증 · DEBUG" />
    </application>
</manifest>
