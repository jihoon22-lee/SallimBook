# Development examples only; use synthetic data.
SALLIMBOOK_ENVIRONMENT=development
SALLIMBOOK_ALLOWED_ORIGINS=["http://localhost:18742","http://127.0.0.1:18742"]
# Passkey ceremonies remain disabled until the actual HTTPS RP and exact origins are set.
# Web origins must also appear in SALLIMBOOK_ALLOWED_ORIGINS; HTTP localhost is not accepted.
SALLIMBOOK_WEBAUTHN_RP_ID=
SALLIMBOOK_WEBAUTHN_WEB_ORIGINS=[]
# Android entries: android:apk-key-hash:<unpadded base64url SHA-256 of the actual signing cert>.
# Configure Digital Asset Links with the actual domain/package/signing certificate first.
SALLIMBOOK_WEBAUTHN_NATIVE_ORIGINS=[]
# Optional server-field keyring path, never key contents. Unset disables account-number storage/reveal.
# SALLIMBOOK_FIELD_ENCRYPTION_KEY_FILE=/private/service-owned/keyring.json
# Run python3 scripts/setup_dev.py to create a private .env with random dev/test passwords.
# Do not copy this example over an existing .env.
SALLIMBOOK_DATABASE_PASSWORD=replace-with-generated-development-password
SALLIMBOOK_TEST_DATABASE_PASSWORD=replace-with-generated-test-password
SALLIMBOOK_DATABASE_URL=postgresql+psycopg://sallimbook:replace-with-generated-development-password@127.0.0.1:18744/sallimbook_dev
SALLIMBOOK_TEST_DATABASE_URL=postgresql+psycopg://sallimbook:replace-with-generated-test-password@127.0.0.1:18745/sallimbook_test
# Native production API_ORIGIN is fixed during the signed build.
# Browser development uses Vite's same-origin /api proxy.

# Optional private documents: absolute directory outside the repository, service-owned 0700.
# Uploads fail closed until the keyring, private scanner socket and OCR tools are configured.
# SALLIMBOOK_DOCUMENT_STORAGE_DIRECTORY=/var/lib/sallimbook/documents
# SALLIMBOOK_DOCUMENT_SCANNER_SOCKET=/run/sallimbook-document-scan/clamd.sock
# SALLIMBOOK_DOCUMENT_TESSERACT_PATH=/usr/bin/tesseract
# SALLIMBOOK_DOCUMENT_PDFTOPPM_PATH=/usr/bin/pdftoppm
# Persistent encrypted-document capacity, shared by all workers (includes tag/retained files).
# SALLIMBOOK_DOCUMENT_HOUSEHOLD_QUOTA_BYTES=268435456
# SALLIMBOOK_DOCUMENT_HOUSEHOLD_QUOTA_COUNT=200
# SALLIMBOOK_DOCUMENT_GLOBAL_QUOTA_BYTES=2147483648
# SALLIMBOOK_DOCUMENT_GLOBAL_QUOTA_COUNT=2000
# SALLIMBOOK_DOCUMENT_MIN_FREE_BYTES=1073741824
