  "milestones": [
    {
      "id": "M0",
      "title": "v1.0 / M0 — 기반·개발 품질",
      "description": "반복 가능한 개발 환경, 공통 API/화면 골격과 합성 테스트 기반을 마련한다.\n\n완료 조건: 문서의 목표 구조를 실제 실행 가능한 골격으로 만들고 양 플랫폼 기본 빌드 및 DB migration을 검증한다.",
      "exit_criteria": "문서의 목표 구조를 실제 실행 가능한 골격으로 만들고 양 플랫폼 기본 빌드 및 DB migration을 검증한다."
    },
    {
      "id": "M1",
      "title": "v1.0 / M1 — 공동 인증·보안 선행 검증",
      "description": "부부 계정·세션·가계 권한과 네이티브 보안 경계의 가능성을 먼저 검증한다.\n\n완료 조건: 타가계 접근 차단과 실기기 지문/Keystore proof가 통과하며 복구 설계의 미검증 가정을 기록한다.",
      "exit_criteria": "타가계 접근 차단과 실기기 지문/Keystore proof가 통과하며 복구 설계의 미검증 가정을 기록한다."
    },
    {
      "id": "M2",
      "title": "v1.0 / M2 — 자산·금융계좌·월 기록",
      "description": "은행·증권·연금·IRP를 포함한 계좌와 월별 자산 기록을 완성한다.\n\n완료 조건: 두 달의 실제 확인치와 비교범위·정정 이력을 정확히 관리하고 중복 합산이 없다.",
      "exit_criteria": "두 달의 실제 확인치와 비교범위·정정 이력을 정확히 관리하고 중복 합산이 없다."
    },
    {
      "id": "M3",
      "title": "v1.0 / M3 — 수입·고정 납부·카드 연결",
      "description": "월 수입, 정기 납부 규칙/회차/실제 금액, 카드 메타데이터를 연결한다.\n\n완료 조건: 예상/실제·원금/이자·카드승인/출금 구분과 카드 종료 영향 안내를 검증한다.",
      "exit_criteria": "예상/실제·원금/이자·카드승인/출금 구분과 카드 종료 영향 안내를 검증한다."
    },
    {
      "id": "M4",
      "title": "v1.0 / M4 — 보험계약·의료 사건·지급",
      "description": "계약, 사건 트리, 실제 비용, 다중 청구와 지급 배분 및 증빙을 완성한다.\n\n완료 조건: 960,000원 의료비와 800,000원 보험금 예시, 환불/반환·분할 지급·청구 없는 지급을 통과한다.",
      "exit_criteria": "960,000원 의료비와 800,000원 보험금 예시, 환불/반환·분할 지급·청구 없는 지급을 통과한다."
    },
    {
      "id": "M5",
      "title": "v1.0 / M5 — 가전·소모품·재고",
      "description": "제품과 공용 소모품 재고, 기기별 교체 주기와 이력을 구현한다.\n\n완료 조건: 입고와 교체가 구분되며 중복·동시 요청에서도 재고가 정확하다.",
      "exit_criteria": "입고와 교체가 구분되며 중복·동시 요청에서도 재고가 정확하다."
    },
    {
      "id": "M6",
      "title": "v1.0 / M6 — 보관함·기기별 보안 완성",
      "description": "암호문 공유, Android 비밀 화면과 로컬 CVC, PC vault, 복구·회전을 완성한다.\n\n완료 조건: 비밀 평문이 일반 API/bridge/백업에 없고 두 구성원·새 기기·복구 시나리오가 검증된다.",
      "exit_criteria": "비밀 평문이 일반 API/bridge/백업에 없고 두 구성원·새 기기·복구 시나리오가 검증된다."
    },
    {
      "id": "M7",
      "title": "v1.0 / M7 — 통합 홈·양 플랫폼 사용성",
      "description": "월 자산과 오늘 소모품 홈, 모든 기능 연결과 오류·충돌 경험을 다듬는다.\n\n완료 조건: Android/PC에서 7개 영역이 연결되어 사용 가능하며 홈 우선순위가 유지된다.",
      "exit_criteria": "Android/PC에서 7개 영역이 연결되어 사용 가능하며 홈 우선순위가 유지된다."
    },
    {
      "id": "M8",
      "title": "v1.0 / M8 — 운영·복구·v1 출시 검증",
      "description": "상시 서버, 정식 APK, 백업 복원, 보안 검증과 전체 인수를 수행한다.\n\n완료 조건: R-01~R-22, 모든 보안 게이트, 두 실기기와 PC의 사용자 여정이 통과한 뒤 v1.0.0을 출시한다.",
      "exit_criteria": "R-01~R-22, 모든 보안 게이트, 두 실기기와 PC의 사용자 여정이 통과한 뒤 v1.0.0을 출시한다."
    }
