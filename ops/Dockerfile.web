FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
# Both proxies bind high loopback ports; a file capability blocks execution under
# the production capability bounding set and no-new-privileges policy.
RUN setcap -r /usr/bin/caddy
COPY dist /srv/web
USER 10001:10001
